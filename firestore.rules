rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Missing marker preserves legacy clients. During deletion, reads/deletes
    // remain available but new content cannot race the final Auth cleanup.
    function canEditContent(uid) {
      return !exists(/databases/$(database)/documents/accountLifecycle/$(uid)) ||
        get(/databases/$(database)/documents/accountLifecycle/$(uid)).data.state == 'ACTIVE';
    }

    // Structural pointers are exclusively server-managed. No client switching.
    // Coordinated deletion still removes this exact root after its lifecycle barrier.
    match /users/{uid} {
      allow get: if isOwner(uid);
      // Once migrated, an ACTIVE client cannot remove the migration barrier.
      allow delete: if isOwner(uid) &&
        (!('activeHouseholdId' in resource.data) || !canEditContent(uid));
      allow create, update: if false;

      match /recipes/{recipeId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && canEditContent(uid);
      }
      match /shopping/{itemId} {
        allow read, delete: if isOwner(uid);
        // Compatibility only until this user's server-side migration begins.
        allow create, update: if isOwner(uid) && canEditContent(uid) &&
          (!exists(/databases/$(database)/documents/users/$(uid)) ||
           !('activeHouseholdId' in get(/databases/$(database)/documents/users/$(uid)).data));
      }
      match /entitlements/pro {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /entitlementGrants/{grantId} {
        allow read, write: if false;
      }
    }

    function householdMember(hid) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }
    function householdWritable(hid) {
      return householdMember(hid) &&
        get(/databases/$(database)/documents/accountLifecycle/$(request.auth.uid)).data.state == 'ACTIVE' &&
        householdContext(hid);
    }
    function householdContext(hid) {
      let uid = request.auth.uid;
      let user = get(/databases/$(database)/documents/users/$(uid)).data;
      let home = get(/databases/$(database)/documents/households/$(hid)).data;
      return user.shoppingMigrationVersion == 1 && user.activeHouseholdId == hid &&
        (privateContext(uid, hid, user, home) || familyContext(uid, hid, user, home));
    }
    function privateContext(uid, hid, user, home) {
      return user.get('familyHouseholdId', null) == null &&
        user.get('privateHouseholdId', hid) == hid && home.ownerUid == uid &&
        get(/databases/$(database)/documents/households/$(hid)/members/$(uid)).data.role == 'owner' &&
        !exists(/databases/$(database)/documents/familyMemberships/$(uid)) &&
        ((home.schemaVersion == 1 && !('kind' in home) && !('state' in home) && !('operationId' in home)) ||
         (home.schemaVersion == 2 && home.kind == 'private' && home.state == 'ACTIVE' && home.operationId == null));
    }
    function familyContext(uid, hid, user, home) {
      let binding = get(/databases/$(database)/documents/familyMemberships/$(uid)).data;
      let member = get(/databases/$(database)/documents/households/$(hid)/members/$(uid)).data;
      let fallback = get(/databases/$(database)/documents/households/$(user.privateHouseholdId)).data;
      return home.schemaVersion == 2 && home.kind == 'family' && home.state == 'ACTIVE' && home.operationId == null &&
        user.familyHouseholdId == hid && user.privateHouseholdId != hid &&
        fallback.schemaVersion == 2 && fallback.kind == 'private' && fallback.state == 'ACTIVE' && fallback.operationId == null && fallback.ownerUid == uid &&
        get(/databases/$(database)/documents/households/$(user.privateHouseholdId)/members/$(uid)).data.role == 'owner' &&
        binding.householdId == hid && binding.state == 'ACTIVE' && binding.operationId == null &&
        binding.role == member.role &&
        ((member.role == 'owner' && home.ownerUid == uid) || (member.role == 'member' && home.ownerUid != uid));
    }
    match /households/{hid} {
      allow read: if householdMember(hid);
      allow write: if false;
      match /members/{uid} {
        allow read: if householdMember(hid);
        allow write: if false;
      }
      match /shoppingItems/{itemId} {
        allow read: if householdWritable(hid);
        allow create, update, delete: if householdWritable(hid);
      }
    }
    match /familyMemberships/{uid} {
      allow read, write: if false;
    }
    match /familyOperations/{operationId} {
      allow read, write: if false;
      match /{document=**} { allow read, write: if false; }
    }
    match /familyRuntime/{document} {
      allow read, write: if false;
    }
    match /billingPurchases/{tokenHash} {
      allow read, write: if false;
    }
    match /accountLifecycle/{uid} {
      allow read, write: if false;
    }
    match /billingAccountBindings/{opaqueBinding} {
      allow read, write: if false;
    }
    match /accountDeletions/{uid} {
      allow read, write: if false;
    }
    match /billingMaintenance/{workId} {
      allow read, write: if false;
    }
    match /rtdnInbox/{eventId} {
      allow read, write: if false;
    }
    match /ingredients/{ingredientId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // No recursive owner permission: unlisted paths are denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
