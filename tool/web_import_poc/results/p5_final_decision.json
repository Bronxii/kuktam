    {
      "case": "unsupported/unknown measure or compound grammar",
      "action": "Row-level review metadata preserving raw text; warning even when current parser leaves token in name with db. No guessed conversion. Scope detector to audited patterns and test false positives such as cloves as spice."
    },
    {
      "case": "silent db fallback risk",
      "action": "Highlight quantity/unit/name and require explicit review acknowledgement or correction. This is new production detection work; POC audit labels are not deployable runtime detection."
    },
    {
      "case": "ambiguous ingredient",
      "action": "Keep whole raw line, highlight unresolved fields; do not auto-save ambiguous/null quantities."
    },
    {
      "case": "fetch/access/no Recipe/multiple Recipe",
      "action": "Short Hungarian actionable message; retain URL/text; allow cancel/retry for transient failures or manual text paste. No 403 bypass; no arbitrary candidate selection."
    },
    {
      "case": "source structure",
      "action": "Preserve available heading metadata. Warn for detected loss/unsupported structure; JSON-LD alone cannot prove an absent visible-page heading. Always provide source link and general source verification notice; do not inject benchmark ground truth."
    },
    {
      "case": "source numeric corruption",
      "action": "Known Nosalty domain requires prominent quantity verification notice and explicit confirmation; offer manual source-text paste. A positive truncated value cannot be reconstructed from JSON-LD. If review safeguard is insufficient in QA, hold this domain out of the initial supported scope."
    }
